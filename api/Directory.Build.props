<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Test projects. Matched by convention so no test csproj repeats this block. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests')) or '$(MSBuildProjectName)' == 'TheSpanishWay.TestKit'">
    <IsTestProject Condition="'$(MSBuildProjectName)' != 'TheSpanishWay.TestKit'">true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TheSpanishWay.TestKit'">
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Test suites get xunit and Shouldly as global usings; no per-file ceremony. -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
