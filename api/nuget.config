<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Central package management requires a single source (or explicit source mapping).
    The machine-level config also defines a work feed; <clear /> keeps this personal
    project restoring from nuget.org alone.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
