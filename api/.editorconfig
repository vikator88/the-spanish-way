root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

[*.cs]
indent_size = 4

# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:error
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion

# Expression preferences
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:suggestion
csharp_style_prefer_primary_constructors = false:suggestion

# Nullability and immutability are load-bearing in the domain model.
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8618.severity = error
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.CA1051.severity = error   # do not declare visible instance fields
dotnet_diagnostic.CA2007.severity = none    # no SynchronizationContext in this codebase
# Cross-language keyword clashes (Error, Result...) do not apply: this codebase is C# only,
# and the domain vocabulary is worth more than VB interop.
dotnet_diagnostic.CA1716.severity = none
# "Random stream" is the design document's term for a per-subsystem draw sequence and has
# nothing to do with System.IO.Stream. The domain vocabulary wins over the suffix rule.
dotnet_diagnostic.CA1711.severity = none

# Naming: interfaces begin with I.
dotnet_naming_rule.interfaces_begin_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_begin_with_i.style = begins_with_i
dotnet_naming_rule.interfaces_begin_with_i.severity = error
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

[test/**/*.cs]
# Test method names read as sentences.
dotnet_diagnostic.CA1707.severity = none
